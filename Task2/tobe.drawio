        <mxCell id="5tz_2NUBXv6_6w7MCRqe-135" value="Авторизация&lt;div&gt;доступа&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="5tz_2NUBXv6_6w7MCRqe-134">
